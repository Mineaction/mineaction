# ── Supabase ────────────────────────────────────────────────
# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-secret-key
# Storage bucket name (created by supabase-schema.sql). Default: media
SUPABASE_BUCKET=media

# ── Auth ────────────────────────────────────────────────────
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Leave SUPABASE_URL empty to run in local JSON-file mode (development only).
